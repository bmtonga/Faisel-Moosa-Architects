# Contact form mail settings – copy to .env for local development.
# In production set these as real environment variables on the host
# (cPanel/Hostinger "Environment variables", Apache SetEnv, Docker, …)
# and do NOT upload a .env file. The PHP code is identical in both cases.

# --- Local (Mailpit): catches every email at http://localhost:8025 ---
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENCRYPTION=none        # none | tls (STARTTLS, usually port 587) | ssl (SMTPS, port 465)
# MAIL_USERNAME=             # leave unset for Mailpit (no auth)
# MAIL_PASSWORD=

# --- Production example (Gmail / Google Workspace with an App Password) ---
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=creativityandflair@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Envelope
MAIL_FROM_ADDRESS=website@faiselmoosaarchitects.com   # must be a sender your SMTP host allows
MAIL_FROM_NAME="Faisel Moosa Architects website"
MAIL_TO_ADDRESS=creativityandflair@gmail.com          # comma-separate for several recipients
MAIL_SUBJECT_PREFIX="[Website enquiry]"

# Optional
# MAIL_TIMEOUT=15
# MAIL_DEBUG=1              # SMTP transcript to the PHP error log (never in production)
